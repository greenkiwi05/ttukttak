---
import ToolLayout from '../../layouts/ToolLayout.astro';
import CharCount from '../../components/tools/CharCount.vue';
import DirectionTabs from '../../components/DirectionTabs.astro';
import { TEXT_COUNT_TABS } from '../../data/textTabs.js';

const faq = [
  { q: '공백 포함과 공백 제외는 뭐가 다른가요?', a: '공백 포함은 띄어쓰기와 줄바꿈까지 모두 센 글자 수예요. 공백 제외는 띄어쓰기·탭·줄바꿈을 뺀 글자 수예요. 자기소개서는 보통 공백 포함 기준이 많지만, 지원하는 곳의 안내를 꼭 확인하세요.' },
  { q: '줄바꿈도 글자로 세나요?', a: '공백 포함 글자 수에서는 줄바꿈 한 번을 1자로 세요. 사이트마다 줄바꿈을 세는 방식이 달라서 몇 글자 차이가 날 수 있어요.' },
  { q: '바이트는 어떻게 계산하나요?', a: '두 가지로 보여줘요. "한글 2바이트"는 한글 등 2바이트, 영문·숫자·공백 1바이트, 줄바꿈 2바이트로 센 값이고, 오래된 입력창이나 문자 메시지 길이를 볼 때 써요. "한글 3바이트"는 실제 파일로 저장할 때의 크기로, 한글 1자가 3바이트예요.' },
  { q: '이모지는 몇 글자인가요?', a: '화면에 보이는 한 글자 단위로 세서 👍 같은 이모지도 1자로 세요.' },
  { q: '입력한 글이 저장되거나 전송되나요?', a: '아니요. 글자 수는 브라우저 안에서만 세고, 글은 어디에도 저장하거나 보내지 않아요. 자기소개서나 기밀 문서도 안심하고 붙여 넣으세요.' },
  { q: '원고지 매수는 정확한가요?', a: '공백 포함 글자 수를 200으로 나눈 단순 계산이에요. 실제 원고지는 문단 첫 칸 비우기 같은 규칙 때문에 더 많이 나올 수 있어요.' },
];
---
<ToolLayout
  slug="char-count"
  description="자기소개서·리포트 글자수를 공백 포함·제외, 바이트까지 바로 세요. 목표 글자수 진행 막대와 초과분 자르기도 있어요. 입력한 글은 저장되거나 전송되지 않아요."
  lead="글을 붙여 넣으면 글자수가 바로 나와요."
  faq={faq}
>
  <DirectionTabs items={TEXT_COUNT_TABS} />
  <CharCount client:load />

  <Fragment slot="guide">
    <h2>자기소개서 글자수 맞추기</h2>
    <p>자기소개서는 문항마다 "공백 포함 1,000자 이내"처럼 글자 수 제한이 있어요. 목표 글자수를 넣으면 남은 글자 수와 진행 막대가 보이고, 넘치면 빨간색으로 알려줘요. 마지막에 '초과분 자르기'로 끝을 맞출 수도 있어요.</p>
    <h2>세는 기준</h2>
    <ul>
      <li><b>공백 포함</b>: 띄어쓰기와 줄바꿈까지 모두 셈 (줄바꿈 1자)</li>
      <li><b>공백 제외</b>: 띄어쓰기·탭·줄바꿈을 뺀 글자</li>
      <li><b>바이트(한글 2)</b>: 한글 2, 영문·숫자·공백 1, 줄바꿈 2</li>
      <li><b>바이트(한글 3)</b>: 실제 저장 크기, 한글 1자 3바이트</li>
    </ul>
    <p>채용 사이트마다 세는 방식이 조금씩 달라서 몇 글자 차이가 날 수 있어요. 제한에 딱 맞추기보다 몇 글자 여유를 두는 게 안전해요.</p>
    <h2>글이 밖으로 나가지 않아요</h2>
    <p>글자 수는 내 브라우저 안에서만 세요. 입력한 글은 서버로 보내지 않고 저장하지도 않아서, 창을 닫으면 사라져요.</p>
  </Fragment>
</ToolLayout>
