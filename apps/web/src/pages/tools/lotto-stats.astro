---
import ToolLayout from '../../layouts/ToolLayout.astro';
import DirectionTabs from '../../components/DirectionTabs.astro';
import LottoStatsView from '../../components/tools/LottoStatsView.vue';
import { LOTTO_TABS } from '../../data/lottoTabs.js';

const faq = [
  { q: '많이 나온 번호를 고르면 당첨 확률이 높아지나요?', a: '아니요. 로또는 매 회차 45개 공에서 새로 추첨해서, 지난 기록과 상관없이 모든 번호 조합의 당첨 확률이 같아요. 통계는 재미로 보는 지난 기록이에요.' },
  { q: '"오래 안 나온 번호"는 곧 나오나요?', a: '그렇지 않아요. 공은 지난 결과를 기억하지 않아서, 오래 안 나왔다고 다음에 나올 확률이 높아지지 않아요. 그냥 마지막으로 나온 뒤 몇 회가 지났는지 보여주는 기록이에요.' },
  { q: '통계는 언제 바뀌나요?', a: '매주 토요일 추첨 결과가 반영되면 통계도 함께 바뀌어요. 기간을 최근 10회부터 전체까지 바꿔 가며 볼 수 있어요.' },
  { q: '보너스 번호 포함은 무슨 뜻인가요?', a: '기본 통계는 당첨번호 6개만 세요. "보너스 번호 포함"을 켜면 회차마다 보너스 번호 1개도 함께 세요.' },
  { q: '"당첨 번호 예측" 서비스는 믿어도 되나요?', a: '로또 번호를 예측해 준다며 돈을 받는 서비스는 피해 사례가 많아 주의가 필요해요. 어떤 방법으로도 다음 당첨번호는 미리 알 수 없어요.' },
];
---
<ToolLayout
  slug="lotto-stats"
  description="로또 1회부터 최신 회차까지 번호별 당첨 횟수, 많이 나온 번호, 오래 안 나온 번호, 홀짝·구간 비율을 그래프로 봐요. 기간별로 바꿔 볼 수 있어요."
  lead="지난 로또 당첨번호를 번호별·기간별로 정리해 보여드려요."
  faq={faq}
>
  <DirectionTabs items={LOTTO_TABS} />
  <LottoStatsView client:load />

  <Fragment slot="guide">
    <h2>무엇을 볼 수 있나요?</h2>
    <ul>
      <li><b>번호별 당첨 횟수</b>: 1번부터 45번까지 각 번호가 몇 번 나왔는지 막대그래프로 보여줘요.</li>
      <li><b>많이·적게 나온 번호</b>: 고른 기간에서 가장 많이, 가장 적게 나온 번호 6개예요.</li>
      <li><b>오래 안 나온 번호</b>: 마지막으로 나온 뒤 가장 오래 지난 번호예요.</li>
      <li><b>홀짝·구간 비율</b>: 한 회차 6개 번호의 홀짝 구성과 번호 구간별 분포예요.</li>
    </ul>
    <h2>통계를 볼 때 알아 두세요</h2>
    <p>로또는 매 회차 독립적으로 추첨해요. 지난 기록은 다음 결과에 영향을 주지 않아서, 어떤 번호 조합이든 1등 확률은 같아요. 통계는 재미로 보고, 번호는 부담 없는 금액 안에서 즐기세요.</p>
    <h2>번호를 직접 뽑고 싶다면</h2>
    <p><a href="/tools/lotto/">로또 번호 생성기</a>에서 무작위 번호를 뽑을 수 있고, <a href="/tools/lotto-results/">로또 당첨번호 조회</a>에서 내 번호의 등수를 맞춰 볼 수 있어요.</p>
  </Fragment>
</ToolLayout>
