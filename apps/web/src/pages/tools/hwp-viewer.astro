---
import ToolLayout from '../../layouts/ToolLayout.astro';
import HwpViewer from '../../components/tools/HwpViewer.vue';
import DirectionTabs from '../../components/DirectionTabs.astro';
import { HWP_TABS } from '../../data/hwpTabs.js';

const faq = [
  { q: '한글 뷰어를 설치해야 하나요?', a: '아니요. 이 페이지에 HWP·HWPX 파일을 넣으면 프로그램 설치 없이 브라우저에서 바로 열려요. 크롬, 엣지, 사파리, 웨일 어디서든 돼요.' },
  { q: '휴대폰에서도 한글 파일을 볼 수 있나요?', a: '네. 카카오톡이나 문자로 받은 HWP 파일을 휴대폰에 저장한 뒤, 이 페이지에서 파일을 고르면 열려요. 앱을 따로 깔 필요가 없어요.' },
  { q: 'HWP와 HWPX는 뭐가 달라요?', a: '둘 다 한글 프로그램 문서예요. HWP는 예전부터 쓰던 형식이고, HWPX는 최근 한글 버전의 기본 저장 형식이에요. 이 뷰어는 두 형식 모두 열 수 있어요.' },
  { q: '문서를 고치거나 인쇄할 수 있나요?', a: '이 뷰어는 보기 전용이라 고칠 수는 없어요. 인쇄하거나 다른 사람에게 보내려면 "PDF로 저장"을 눌러 PDF로 만든 뒤 쓰면 돼요.' },
  { q: '문서가 원본과 다르게 보여요.', a: '글자와 기본 표는 대부분 잘 보이지만, 복잡한 표·도형·글상자·특수한 글꼴은 다르게 보일 수 있어요. 정확한 모양이 중요하면 한글 프로그램이 있는 PC에서 확인하세요.' },
  { q: '파일이 서버로 올라가나요?', a: '아니요. 문서를 읽는 엔진을 브라우저로 불러와 내 기기 안에서만 열어요. 공문서나 개인정보가 담긴 문서도 밖으로 나가지 않아요. 처음 한 번은 엔진(약 7MB)을 내려받느라 조금 걸려요.' },
];
---
<ToolLayout
  slug="hwp-viewer"
  description="한글 프로그램이나 뷰어 설치 없이 HWP·HWPX 파일을 브라우저에서 바로 열어 봐요. 맥·휴대폰에서도 되고, 파일은 서버로 올라가지 않아 공문서도 안심이에요."
  lead="한글(HWP) 파일을 설치 없이 바로 열어 보세요. 휴대폰·맥에서도 돼요."
  faq={faq}
>
  <DirectionTabs items={HWP_TABS} />
  <HwpViewer client:load />

  <Fragment slot="guide">
    <h2>한글 파일이 안 열릴 때</h2>
    <p>학교 가정통신문, 주민센터 서식, 입찰 공고, 회사 공문은 아직 한글(HWP) 파일로 오는 경우가 많아요. 그런데 맥, 크롬북, 휴대폰, 한글이 설치되지 않은 회사 PC에서는 파일을 눌러도 열리지 않죠. 이럴 때 이 페이지에 파일을 넣으면 바로 내용을 볼 수 있어요.</p>
    <h2>사용 방법</h2>
    <ol>
      <li>HWP 또는 HWPX 파일을 위 칸에 끌어다 놓거나 눌러서 골라요.</li>
      <li>처음 한 번은 문서 엔진을 불러오느라 몇 초 걸려요.</li>
      <li>문서가 열리면 스크롤해서 쪽을 넘기며 봐요.</li>
      <li>인쇄하거나 보관하려면 'PDF로 저장'을 눌러 PDF로 받아요.</li>
    </ol>
    <h2>휴대폰에서 보는 법</h2>
    <p>카카오톡이나 메일로 받은 HWP 파일은 먼저 휴대폰에 저장해요. 그다음 이 페이지에서 위 칸을 누르면 휴대폰의 파일 목록이 열리니, 저장한 파일을 고르면 돼요.</p>
    <h2>열 수 없는 문서</h2>
    <p>암호가 걸린 문서와, 복사·인쇄를 막아 둔 배포용 문서는 열 수 없어요. 암호 문서는 한글 프로그램에서 암호를 푼 뒤 다시 시도하고, 배포용 문서는 보낸 곳에 일반 HWP나 PDF로 다시 요청해 주세요.</p>
    <h2>PDF를 한글로 바꾸고 싶다면</h2>
    <p>반대로 PDF 문서를 한글에서 고쳐 쓰고 싶다면 위의 'PDF → HWP' 탭에서 PDF를 한글 문서(HWPX)로 바꿀 수 있어요.</p>
  </Fragment>
</ToolLayout>
