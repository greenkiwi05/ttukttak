---
import ToolLayout from '../../layouts/ToolLayout.astro';
import DirectionTabs from '../../components/DirectionTabs.astro';
import NeisCount from '../../components/tools/NeisCount.vue';
import { TEXT_COUNT_TABS } from '../../data/textTabs.js';

const faq = [
  { q: '나이스는 바이트를 어떻게 세나요?', a: '교육부 학교생활기록부 종합지원포털 답변에 따르면 교육정보시스템은 한글 1자를 3바이트, 영문·숫자 1자를 1바이트, 엔터를 1바이트로 세요. 이 계산기도 같은 기준으로 세요. 띄어쓰기도 1바이트예요.' },
  { q: '엔터는 2바이트 아닌가요?', a: '엔터를 2바이트로 세는 계산기도 있지만, 학교생활기록부 종합지원포털의 답변은 1바이트예요. 이 계산기는 1바이트로 세요. 한글 문서에서 복사한 줄바꿈도 1바이트로 바꿔 세요.' },
  { q: '항목별 입력 제한은 얼마인가요?', a: '항목별 최대 글자수는 학교급·학년도마다 바뀌어요. 예를 들어 2026학년도에는 창의적 체험활동 일부 영역의 최대 글자수가 줄었어요. 그래서 이 계산기는 제한값을 미리 넣어 두지 않아요. 그해 학교생활기록부 기재요령이나 나이스 입력 화면에서 확인한 값을 넣어 주세요.' },
  { q: '"500자"는 몇 바이트예요?', a: '글자 수 제한은 한글 기준이라 500자는 1,500바이트예요. 영문·숫자·띄어쓰기가 섞이면 같은 1,500바이트 안에 더 많은 글자가 들어가요.' },
  { q: '가운뎃점(·)이나 특수문자는요?', a: '이 계산기는 글자가 실제로 차지하는 바이트(UTF-8)로 세서, 가운뎃점(·)은 2바이트, 이모지는 4바이트예요. 바이트가 다른 글자는 따로 표시해 드려요. 나이스에서 입력되지 않는 글자가 있을 수 있으니 마지막에는 나이스 입력 화면에서 확인하세요.' },
  { q: '입력한 생활기록부 내용이 저장되나요?', a: '아니요. 학생 정보가 담긴 글이라 저장하거나 서버로 보내지 않아요. 바이트 계산은 브라우저 안에서만 하고, 입력 제한 값만 다음에 쓰기 편하게 이 기기에 기억해요.' },
];
---
<ToolLayout
  slug="neis-byte"
  description="생활기록부 글을 나이스 기준(한글 3·영문 1·엔터 1바이트)으로 바로 세요. 남은 바이트와 초과분을 보여 주고, 학생 정보는 저장하거나 보내지 않아요."
  lead="생활기록부에 넣을 글을 붙여 넣으면 나이스 기준 바이트가 바로 나와요."
  faq={faq}
>
  <DirectionTabs items={TEXT_COUNT_TABS} />
  <NeisCount client:load />

  <Fragment slot="guide">
    <h2>나이스 바이트 세는 기준</h2>
    <ul>
      <li><b>한글</b> 1자 = 3바이트</li>
      <li><b>영문·숫자</b> 1자 = 1바이트</li>
      <li><b>띄어쓰기</b> = 1바이트</li>
      <li><b>엔터(줄바꿈)</b> = 1바이트</li>
    </ul>
    <p>교육부 학교생활기록부 종합지원포털의 기재 문의 답변을 따랐어요. 그래서 '500자'로 정해진 항목은 한글만 쓰면 1,500바이트까지 들어가요.</p>
    <h2>사용 방법</h2>
    <ol>
      <li>한글 문서나 메모에서 쓴 글을 붙여 넣어요.</li>
      <li>그해 기재요령에서 확인한 입력 제한을 한글 글자 수나 바이트로 넣어요. 다음에 열면 기억하고 있어요.</li>
      <li>남은 바이트를 보며 고치고, 넘치면 빨간색으로 알려 줘요.</li>
      <li>'띄어쓰기·줄바꿈 정리'로 복사하면서 생긴 겹친 띄어쓰기와 빈 줄을 한 번에 정리할 수 있어요.</li>
    </ol>
    <h2>입력이 안 될 때 확인할 것</h2>
    <ul>
      <li>한글 문서에서 복사하면 눈에 안 보이는 띄어쓰기가 줄 끝에 남을 수 있어요. 정리 버튼으로 지워 보세요.</li>
      <li>가운뎃점(·)·괄호 같은 특수문자, 이모지는 바이트가 달라요. 계산기가 따로 표시해 줘요.</li>
      <li>항목별 제한은 해마다 바뀔 수 있어요. 최종 확인은 나이스 입력 화면에서 하세요.</li>
    </ul>
    <h2>학생 정보는 저장하지 않아요</h2>
    <p>붙여 넣은 글은 브라우저 안에서만 세고 어디에도 보내거나 저장하지 않아요. 창을 닫으면 사라져요.</p>
  </Fragment>
</ToolLayout>
