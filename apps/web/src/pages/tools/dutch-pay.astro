---
import ToolLayout from '../../layouts/ToolLayout.astro';
import DutchPay from '../../components/tools/DutchPay.vue';

const faq = [
  { q: '1차, 2차 참여한 사람이 다르면 어떻게 하나요?', a: '"차수별" 탭에서 차수마다 금액을 넣고 참여한 사람만 골라 주세요. 사람마다 참여한 차수의 몫만 더해서 계산해요.' },
  { q: '100원 단위로 딱 맞게 나누고 싶어요.', a: '금액 단위를 100원으로 고르면 1인당 금액이 100원 단위로 맞춰져요. 올림을 고르면 총무가 몇백 원을 더 받고, 내림을 고르면 총무가 조금 더 내요. 그 차액도 함께 보여줘요.' },
  { q: '정산 문구는 어떻게 보내나요?', a: '"정산 문구 복사"를 누르면 차수별 금액과 사람별 낼 돈이 정리된 문구가 복사돼요. 단톡방에 그대로 붙여 넣으면 돼요. 입금 계좌를 적으면 문구 끝에 함께 들어가요.' },
  { q: '입력한 이름이나 계좌가 저장되나요?', a: '아니요. 계산은 브라우저 안에서만 하고, 이름과 계좌번호는 어디에도 저장하거나 보내지 않아요.' },
  { q: '몇 명까지 나눌 수 있나요?', a: '총액 ÷ 인원 방식은 100명까지, 차수별 방식은 이름을 넣는 만큼 나눌 수 있어요.' },
];
---
<ToolLayout
  slug="dutch-pay"
  description="회식·여행비 더치페이를 1인당 금액으로 바로 나눠요. 1차·2차 참여자가 달라도 사람별로 정산하고, 100원 단위 맞춤과 단톡방용 정산 문구 복사까지 돼요."
  lead="총액과 인원만 넣거나, 차수별로 참여한 사람을 골라 정산하세요."
  faq={faq}
>
  <DutchPay client:load />

  <Fragment slot="guide">
    <h2>두 가지 정산 방법</h2>
    <ul>
      <li><b>총액 ÷ 인원</b>: 모두 같은 금액을 낼 때. 총액과 인원만 넣으면 1인당 금액이 나와요.</li>
      <li><b>차수별</b>: 1차는 4명, 2차는 2명처럼 참여한 사람이 다를 때. 차수마다 금액과 참여자를 고르면 사람별로 낼 돈이 따로 나와요.</li>
    </ul>
    <h2>금액 단위 맞추기</h2>
    <p>100,000원을 3명이 나누면 33,333원이 돼서 송금하기 번거로워요. 100원 단위 올림을 고르면 33,400원씩 걷고 총무에게 200원이 남는다고 알려줘요. 내림을 고르면 33,300원씩 걷고 총무가 100원을 더 내요.</p>
    <h2>정산 문구로 깔끔하게</h2>
    <p>계산이 끝나면 정산 문구를 복사해서 단톡방에 붙여 넣으세요. 차수별 금액, 사람별 낼 돈, 입금 계좌가 한 번에 정리돼 있어서 따로 설명할 필요가 없어요.</p>
  </Fragment>
</ToolLayout>
