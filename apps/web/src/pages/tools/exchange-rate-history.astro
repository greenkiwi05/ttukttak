---
import ToolLayout from '../../layouts/ToolLayout.astro';
import DirectionTabs from '../../components/DirectionTabs.astro';
import FxHistory from '../../components/tools/FxHistory.vue';

const faq = [
  { q: '언제부터 환율을 조회할 수 있나요?', a: '2016년 1월부터의 한국수출입은행 고시 환율을 모으고 있어요. 과거 자료는 매시간 조금씩 채우고 있어서, 아직 다 채워지지 않았다면 화면 위에 지금 조회 가능한 날짜가 표시돼요.' },
  { q: '주말이나 공휴일 환율은 왜 없나요?', a: '환율은 은행 영업일에만 고시돼요. 주말이나 공휴일을 고르면 그 전 마지막 영업일의 환율을 보여드려요. 실제 거래나 회계에서도 보통 직전 고시 환율을 써요.' },
  { q: '월평균 환율은 어떻게 계산하나요?', a: '그 달에 고시된 매매기준율을 모두 더해 고시 일수로 나눈 단순 평균이에요. 회사나 기관마다 쓰는 평균 방식이 다를 수 있으니, 공식 서류에는 제출처가 정한 기준을 확인하세요.' },
  { q: '은행에서 실제로 거래된 환율과 같은가요?', a: '여기 나오는 값은 한국수출입은행이 하루 한 번 고시한 환율이에요. 은행 창구 환율은 은행·시간·우대율에 따라 달라서 조금 차이가 날 수 있어요.' },
  { q: '그래프에서 특정 날짜 값을 보려면 어떻게 하나요?', a: '그래프 위에 마우스를 올리거나 손가락으로 누르면 그날의 환율이 표시돼요. 아래의 "전체 통화 환율 보기"를 누르면 그날 모든 통화의 환율표로 넘어가요.' },
];
---
<ToolLayout
  slug="exchange-rate-history"
  description="날짜별 과거 환율과 기간별 환율 추이 그래프를 무료로 조회해요. 달러·엔화·유로 등 한국수출입은행 고시 환율, 월평균·최고·최저까지 한눈에 봐요."
  lead="원하는 날짜의 환율과 기간별 환율 흐름을 바로 확인해요."
  faq={faq}
>
  <DirectionTabs items={[{ href: '/tools/exchange-rate/', label: '오늘 환율 계산' }, { href: '/tools/exchange-rate-history/', label: '과거 환율 조회' }]} />
  <FxHistory client:load />

  <Fragment slot="guide">
    <h2>과거 환율이 필요할 때</h2>
    <ul>
      <li><b>해외 결제·송금 확인</b>: 몇 달 전 결제한 날 환율이 얼마였는지 확인해요.</li>
      <li><b>서류·정산</b>: 특정 날짜나 월평균 환율이 필요한 경비 정산에 참고해요.</li>
      <li><b>환전 시점 고민</b>: 최근 1년, 3년 동안 환율이 어떻게 움직였는지 그래프로 봐요.</li>
    </ul>
    <h2>어떤 환율인가요?</h2>
    <p>한국수출입은행이 은행 영업일마다 고시하는 환율이에요. 그래프와 월평균은 매매기준율로 계산하고, 날짜로 조회하면 송금 보낼 때·받을 때 환율도 함께 볼 수 있어요. 엔화와 루피아는 100단위 기준이에요.</p>
    <h2>그래프 읽는 법</h2>
    <p>선이 올라가면 원화 가치가 떨어져서 같은 외화를 사는 데 원화가 더 든다는 뜻이에요. 기간 변동은 고른 기간의 첫날과 마지막 날 환율을 비교한 값이에요. 오늘 환율로 금액을 계산하려면 <a href="/tools/exchange-rate/">환율 계산기</a>를 쓰세요.</p>
  </Fragment>
</ToolLayout>
