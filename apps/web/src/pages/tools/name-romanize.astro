---
import ToolLayout from '../../layouts/ToolLayout.astro';
import NameRomanize from '../../components/tools/NameRomanize.vue';

const faq = [
  { q: '한글 이름은 어떤 기준으로 영어로 바꾸나요?', a: '국어의 로마자 표기법(2000년 고시)을 따라요. 이름은 소리 나는 대로 바꾸지 않고 글자 그대로 옮겨서, 한복남은 Han Bongnam이 아니라 Han Boknam이 돼요.' },
  { q: '성은 왜 여러 가지로 나오나요?', a: '김(Kim), 이(Lee), 박(Park)처럼 표기법과 다르게 오래 써 온 표기가 널리 쓰여요. 그래서 흔히 쓰는 표기를 먼저 보여주고, 표기법대로의 표기도 함께 골라 볼 수 있게 했어요.' },
  { q: '이름 사이에 붙임표(-)를 넣어야 하나요?', a: '넣어도 되고 안 넣어도 돼요. Gildong과 Gil-dong 모두 표기법에서 허용해요. 다만 한 번 정한 표기는 여권·카드·서류에서 같게 쓰는 게 좋아요.' },
  { q: '여권 영문 이름도 이걸로 정하면 되나요?', a: '처음 여권을 만들 때 참고할 수 있어요. 여권 영문 이름은 한 번 정하면 바꾸기 어려우니, 가족의 여권 표기나 이미 쓰는 해외 카드 표기와 맞추는 걸 함께 생각해 보세요. 자세한 기준은 여권 발급 기관의 안내를 확인하세요.' },
  { q: '입력한 이름이 저장되나요?', a: '아니요. 변환은 브라우저 안에서만 하고 이름은 어디에도 보내거나 저장하지 않아요.' },
];
---
<ToolLayout
  slug="name-romanize"
  description="한글 이름을 영어(로마자)로 바로 바꿔요. 국어의 로마자 표기법을 따르고, Kim·Lee·Park 같은 흔한 성 표기를 골라 여권식·영어권식으로 복사할 수 있어요."
  lead="한글 이름을 넣으면 영문 표기를 여러 형식으로 알려드려요."
  faq={faq}
>
  <NameRomanize client:load />

  <Fragment slot="guide">
    <h2>영문 이름 표기 규칙</h2>
    <ul>
      <li><b>성과 이름은 띄어 써요</b>: Hong Gildong</li>
      <li><b>이름은 글자 그대로</b>: 소리가 바뀌어도 반영하지 않아요. 복남 → Boknam</li>
      <li><b>붙임표는 선택</b>: Gildong, Gil-dong 모두 괜찮아요</li>
      <li><b>성은 관례 표기도 많이 써요</b>: 김 Kim, 이 Lee, 박 Park, 최 Choi, 정 Jung</li>
    </ul>
    <h2>어떤 형식을 쓸까요</h2>
    <p>여권이나 비자 서류처럼 성(Surname)과 이름(Given name)을 나눠 적는 곳은 "여권·서류" 형식을, 영어 이메일 서명이나 명함은 이름을 먼저 쓰는 "영어권 순서"를 많이 써요. 어떤 형식을 고르든 철자는 모든 서류에서 같게 맞추는 게 가장 중요해요.</p>
    <h2>이미 쓰는 영문 이름이 있다면</h2>
    <p>여권, 해외 결제 카드, 항공권, 학교 증명서의 영문 이름이 서로 다르면 확인 과정에서 번거로울 수 있어요. 이미 쓰고 있는 표기가 있다면 그 철자를 그대로 쓰세요.</p>
  </Fragment>
</ToolLayout>
