---
import ToolLayout from '../../layouts/ToolLayout.astro';
import DirectionTabs from '../../components/DirectionTabs.astro';
import LottoResults from '../../components/tools/LottoResults.vue';
import { LOTTO_TABS } from '../../data/lottoTabs.js';

const faq = [
  { q: '이번 주 로또 당첨번호는 언제 나오나요?', a: '로또 6/45는 매주 토요일 저녁에 추첨해요. 추첨이 끝나고 결과가 공개되면 이 페이지에도 보통 한두 시간 안에 반영돼요.' },
  { q: '당첨번호는 어디서 가져오나요?', a: '로또를 운영하는 동행복권 홈페이지에 공개된 회차별 당첨 결과를 모아서 보여드려요. 실제 당첨금 수령 전에는 동행복권 홈페이지나 판매점에서 한 번 더 확인하세요.' },
  { q: '2등과 3등은 어떻게 다른가요?', a: '당첨번호 6개 중 5개를 맞히고, 나머지 한 번호가 보너스 번호와 같으면 2등, 아니면 3등이에요. 보너스 번호는 2등을 가릴 때만 써요.' },
  { q: '표에 나온 당첨금을 그대로 받나요?', a: '아니요. 표의 금액은 세금을 떼기 전 금액이에요. 일정 금액을 넘는 당첨금에는 세금이 붙어서 실제로 받는 돈은 더 적어요. 정확한 세금과 수령 방법은 동행복권 안내를 확인하세요.' },
  { q: '내 번호를 넣으면 저장되나요?', a: '아니요. 내 번호 맞춰보기는 브라우저 안에서만 계산하고, 입력한 번호는 서버로 보내거나 저장하지 않아요.' },
];
---
<ToolLayout
  slug="lotto-results"
  description="로또 6/45 회차별 당첨번호와 등수별 당첨금을 바로 조회해요. 내 번호를 넣으면 이번 회차 등수와 1회부터 지난 모든 회차 결과까지 맞춰 봐요."
  lead="회차를 고르면 당첨번호와 당첨금을, 내 번호를 넣으면 등수를 알려드려요."
  faq={faq}
>
  <DirectionTabs items={LOTTO_TABS} />
  <LottoResults client:load />

  <Fragment slot="guide">
    <h2>로또 등수 기준</h2>
    <ul>
      <li><b>1등</b>: 당첨번호 6개를 모두 맞힘</li>
      <li><b>2등</b>: 5개를 맞히고 나머지 하나가 보너스 번호와 같음</li>
      <li><b>3등</b>: 5개를 맞힘</li>
      <li><b>4등</b>: 4개를 맞힘</li>
      <li><b>5등</b>: 3개를 맞힘</li>
    </ul>
    <h2>지난 회차 전체로 맞춰보기</h2>
    <p>늘 같은 번호로 사는 분이라면, 그 번호가 1회부터 지금까지 몇 번 당첨됐을지 궁금할 수 있어요. 내 번호를 넣으면 이번 회차 등수와 함께 지난 모든 회차에서 몇 등에 몇 번 당첨됐을지 보여드려요.</p>
    <h2>당첨금 확인할 때 주의하세요</h2>
    <p>표의 1인당 당첨금은 세금을 떼기 전 금액이에요. 당첨 여부와 수령 방법은 반드시 동행복권 홈페이지나 판매점에서 한 번 더 확인하세요. 번호별로 얼마나 자주 나왔는지는 <a href="/tools/lotto-stats/">로또 번호 통계</a>에서 볼 수 있어요.</p>
  </Fragment>
</ToolLayout>
