---
import ToolLayout from '../../layouts/ToolLayout.astro';
import DirectionTabs from '../../components/DirectionTabs.astro';
import JpgToPdf from '../../components/tools/JpgToPdf.vue';

const faq = [
  { q: '사진이 서버로 올라가나요?', a: '아니요. PDF는 브라우저 안에서 만들어져요. 신분증, 통장 사본, 서류 사진도 내 기기 밖으로 나가지 않아요.' },
  { q: '여러 장을 PDF 하나로 묶을 수 있나요?', a: '네. 사진을 여러 장 넣으면 한 장이 한 페이지가 되는 PDF 하나로 만들어져요. 최대 100장까지 넣을 수 있어요.' },
  { q: '페이지 순서는 어떻게 바꾸나요?', a: '미리보기 사진을 끌어서 옮기거나 ‹ › 버튼을 누르면 돼요. 번호 순서대로 PDF 페이지가 만들어져요.' },
  { q: 'A4와 "사진 크기 그대로"는 뭐가 다른가요?', a: 'A4는 모든 페이지를 A4 용지 크기로 맞추고 사진을 여백 안에 넣어요. 인쇄하거나 서류로 낼 때 좋아요. "사진 크기 그대로"는 사진마다 페이지 크기가 사진에 맞춰져요.' },
  { q: 'PNG나 아이폰 사진도 되나요?', a: 'JPG, PNG, WEBP 등 브라우저가 열 수 있는 이미지는 모두 돼요. 아이폰 HEIC 사진은 HEIC JPG 변환 도구로 먼저 바꿔 주세요.' },
  { q: '사진이 옆으로 누워서 들어가요.', a: '휴대폰 사진의 회전 정보를 반영해서 넣어요. 그래도 누워 있다면 방향을 "가로" 또는 "세로"로 직접 골라 보세요.' },
];
---
<ToolLayout
  slug="jpg-to-pdf"
  description="JPG·PNG 사진 여러 장을 PDF 하나로 바로 만들어요. A4 맞춤, 순서 바꾸기, 여백 조절까지. 사진은 서버로 올라가지 않고 브라우저 안에서만 처리돼요."
  lead="사진을 넣고 순서를 맞춘 뒤 PDF로 저장하세요. 서버 업로드 없이요."
  faq={faq}
>
  <DirectionTabs items={[{ href: '/tools/jpg-to-pdf/', label: 'JPG → PDF' }, { href: '/tools/pdf-to-jpg/', label: 'PDF → JPG' }]} />
  <JpgToPdf client:load />

  <Fragment slot="guide">
    <h2>이럴 때 써요</h2>
    <p>휴대폰으로 찍은 서류를 PDF 하나로 제출해야 할 때, 영수증이나 증빙 사진을 묶어서 보낼 때, 손글씨 과제를 스캔 대신 사진으로 찍어 낼 때 편해요.</p>
    <h2>사용 방법</h2>
    <ol>
      <li>사진을 끌어다 놓거나 눌러서 골라요. 여러 장 한 번에 돼요.</li>
      <li>미리보기를 끌어서 페이지 순서를 맞춰요.</li>
      <li>용지(A4·Letter·사진 크기 그대로), 방향, 여백을 골라요.</li>
      <li>'PDF 만들기'를 누르면 바로 저장돼요.</li>
    </ol>
    <h2>서버 업로드 없음</h2>
    <p>대부분의 PDF 변환 사이트는 사진을 서버로 올려서 만들어요. 이 도구는 내 브라우저 안에서 PDF를 만들기 때문에 개인정보가 담긴 사진도 안심하고 쓸 수 있어요.</p>
  </Fragment>
</ToolLayout>
