---
import ToolLayout from '../../layouts/ToolLayout.astro';
import DirectionTabs from '../../components/DirectionTabs.astro';
import VideoCompress from '../../components/tools/VideoCompress.vue';

const faq = [
  { q: '동영상이 서버로 올라가나요?', a: '아니요. 영상은 브라우저 안에서만 줄여요. 가족 영상이나 개인 영상도 내 기기 밖으로 나가지 않아요.' },
  { q: '"화질로 정하기"와 "용량으로 정하기"는 뭐가 다른가요?', a: '화질로 정하기는 높음·보통·낮음 중에 고르면 알맞게 줄여요. 용량으로 정하기는 "25MB 이하"처럼 목표를 정하면 그 아래로 맞추도록 화질을 정해요.' },
  { q: '얼마나 걸리나요?', a: '영상 길이와 기기 성능에 따라 달라요. 컴퓨터에서는 보통 영상 길이보다 짧게 걸리고, 휴대폰이나 오래된 기기에서는 더 걸릴 수 있어요. 줄이는 동안 창을 닫지 마세요.' },
  { q: '용량을 많이 줄이려면 어떻게 하나요?', a: '해상도를 720p나 480p로 낮추는 게 가장 효과가 커요. 화질을 "낮음"으로 고르거나 소리를 빼도 더 줄어들어요.' },
  { q: '어떤 형식으로 저장되나요?', a: 'MP4 형식으로 저장돼요. 휴대폰, 컴퓨터, 메신저 대부분에서 바로 재생돼요.' },
  { q: '변환이 안 돼요.', a: '이 도구는 브라우저에 들어 있는 동영상 변환 기능을 써요. 크롬·엣지·사파리 최신 버전에서 열어 주세요. 영상이 너무 크면 해상도를 낮춰서 다시 시도해 보세요.' },
];
---
<ToolLayout
  slug="video-compress"
  description="동영상 용량을 화질이나 목표 용량(25MB 이하 등)에 맞춰 줄여요. 해상도 낮추기, 소리 빼기도 돼요. 영상은 서버로 올라가지 않고 브라우저 안에서만 처리돼요."
  lead="동영상을 넣고 화질이나 목표 용량을 고르면 작게 줄여드려요. 서버 업로드 없이요."
  faq={faq}
>
  <DirectionTabs items={[{ href: '/tools/image-compress/', label: '사진 줄이기' }, { href: '/tools/video-compress/', label: '동영상 줄이기' }]} />
  <VideoCompress client:load />

  <Fragment slot="guide">
    <h2>이럴 때 써요</h2>
    <p>메신저나 이메일로 보낼 영상이 너무 클 때, 과제·지원서에 "100MB 이하"처럼 용량 제한이 있을 때, 휴대폰 저장 공간을 아끼고 싶을 때 쓰면 좋아요.</p>
    <h2>용량을 줄이는 원리</h2>
    <ul>
      <li><b>해상도</b>: 4K·1080p 영상을 720p로 낮추면 용량이 크게 줄어요. 휴대폰 화면으로 보기에는 720p로도 충분한 경우가 많아요.</li>
      <li><b>화질(비트레이트)</b>: 1초에 담는 정보량을 줄여요. 너무 낮추면 움직임이 많은 장면이 뭉개질 수 있어요.</li>
      <li><b>소리</b>: 소리가 필요 없다면 빼서 조금 더 줄일 수 있어요.</li>
    </ul>
    <h2>서버 업로드 없음</h2>
    <p>대부분의 동영상 압축 사이트는 영상을 서버로 올려서 줄여요. 이 도구는 브라우저에 들어 있는 동영상 변환 기능으로 내 기기 안에서만 처리해서, 큰 영상을 올리느라 기다릴 필요도 없고 개인 영상이 밖으로 나가지도 않아요.</p>
    <p>사진은 <a href="/tools/image-compress/">사진 용량 줄이기</a>를 써 주세요.</p>
  </Fragment>
</ToolLayout>
