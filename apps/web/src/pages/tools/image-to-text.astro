---
import ToolLayout from '../../layouts/ToolLayout.astro';
import ImageOcr from '../../components/tools/ImageOcr.vue';

const faq = [
  { q: '사진이 서버로 올라가나요?', a: '아니요. 글자 인식은 내 브라우저 안에서 이루어져요. 처음 한 번은 인식 엔진과 한국어 데이터를 내려받느라 시간이 걸리지만, 사진은 어디에도 보내지 않아요.' },
  { q: '처음에 왜 오래 걸리나요?', a: '글자를 알아보는 데 필요한 인식 엔진과 언어 데이터(몇 MB)를 처음 한 번 내려받기 때문이에요. 한 번 받은 뒤에는 브라우저에 저장돼서 다음부터는 빨라요.' },
  { q: '어떤 사진이 잘 읽히나요?', a: '글자가 크고 또렷하며 반듯하게 찍힌 사진, 화면 캡처가 가장 잘 읽혀요. 손글씨, 흐리거나 기울어진 사진, 배경이 복잡한 사진은 틀리는 글자가 많을 수 있어요.' },
  { q: '캡처한 화면을 바로 넣을 수 있나요?', a: '네. 화면을 캡처한 뒤 이 페이지에서 Ctrl+V(맥은 Cmd+V)를 누르면 바로 글자를 읽어요.' },
  { q: '틀린 글자는 어떻게 하나요?', a: '결과 칸에서 바로 고칠 수 있어요. 고친 뒤 "글자 복사하기"를 누르면 고친 내용이 복사돼요.' },
];
---
<ToolLayout
  slug="image-to-text"
  description="사진·캡처 이미지 속 글자를 텍스트로 뽑아 바로 복사해요. 한국어와 영어를 읽고, 사진은 서버에 올리지 않고 브라우저 안에서 인식해요."
  lead="사진 속 글자를 텍스트로 바꿔 드려요. 캡처는 Ctrl+V로 바로 붙여 넣으세요."
  faq={faq}
>
  <ImageOcr client:load />

  <Fragment slot="guide">
    <h2>이럴 때 써요</h2>
    <ul>
      <li><b>문서 사진</b>에서 글자를 옮겨 적기 귀찮을 때</li>
      <li><b>캡처한 화면</b>의 글자를 복사할 수 없을 때</li>
      <li><b>명함·안내문</b>의 전화번호나 주소를 옮길 때</li>
    </ul>
    <h2>잘 읽히게 찍는 방법</h2>
    <p>글자가 화면에 크게 나오도록 가까이서, 종이와 평행하게 찍어 주세요. 그림자나 빛 반사가 없고 초점이 맞으면 정확도가 높아져요. 여러 쪽이라면 한 장씩 나눠서 넣는 게 좋아요.</p>
    <h2>함께 쓰면 좋은 도구</h2>
    <p>뽑은 글의 글자수가 궁금하면 <a href="/tools/char-count/">글자수 세기</a>, 사진을 PDF로 묶으려면 <a href="/tools/jpg-to-pdf/">JPG PDF 변환</a>을 써 보세요.</p>
  </Fragment>
</ToolLayout>
