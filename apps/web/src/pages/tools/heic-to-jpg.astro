---
import ToolLayout from '../../layouts/ToolLayout.astro';
import HeicToJpg from '../../components/tools/HeicToJpg.vue';

const faq = [
  { q: '사진이 서버로 올라가나요?', a: '아니요. 변환은 브라우저 안에서만 해요. 사진이 내 기기를 떠나지 않아서 개인 사진도 안심하고 바꿀 수 있어요.' },
  { q: 'HEIC 파일이 뭔가요?', a: '아이폰이 사진을 저장하는 기본 형식이에요. JPG보다 용량이 작지만 윈도우 PC나 일부 사이트에서는 열리지 않거나 업로드가 안 될 때가 있어요.' },
  { q: '여러 장을 한 번에 바꿀 수 있나요?', a: '네. 최대 30장까지 한 번에 넣을 수 있고, 변환이 끝나면 한 장씩 저장하거나 ZIP 파일로 한 번에 받을 수 있어요.' },
  { q: '변환하면 화질이 떨어지나요?', a: 'JPG 품질을 90%로 두면 눈으로 보기에 거의 차이가 없어요. 용량을 더 줄이고 싶으면 품질을 낮추거나, 변환 후 이미지 용량 줄이기 도구를 써 보세요.' },
  { q: '아이폰에서 처음부터 JPG로 찍을 수는 없나요?', a: '아이폰 설정 → 카메라 → 포맷에서 "높은 호환성"을 고르면 JPG로 저장돼요. 이미 찍은 HEIC 사진은 이 도구로 바꾸면 돼요.' },
  { q: '변환이 느려요.', a: '변환은 내 기기의 성능으로 처리해요. 사진이 크거나 많으면 시간이 걸릴 수 있으니 잠시 기다려 주세요.' },
];
---
<ToolLayout
  slug="heic-to-jpg"
  description="아이폰 사진(HEIC)을 JPG로 바로 바꿔요. 여러 장 한 번에 변환하고 ZIP으로 받을 수 있어요. 사진은 서버로 올라가지 않고 브라우저 안에서만 처리돼요."
  lead="아이폰 HEIC 사진을 넣으면 JPG로 바꿔드려요. 서버 업로드 없이요."
  faq={faq}
>
  <HeicToJpg client:load />

  <Fragment slot="guide">
    <h2>HEIC를 JPG로 바꿔야 하는 경우</h2>
    <p>아이폰으로 찍은 사진을 PC로 옮기면 .HEIC 파일이 되는 경우가 많아요. 윈도우 기본 사진 앱에서 안 열리거나, 관공서·쇼핑몰·채용 사이트에서 업로드를 막는 일이 생겨요. 이럴 때 JPG로 바꾸면 어디서나 쓸 수 있어요.</p>
    <h2>사용 방법</h2>
    <ol>
      <li>HEIC 사진을 끌어다 놓거나 눌러서 골라요. 여러 장도 돼요.</li>
      <li>필요하면 JPG 품질을 조절해요. 기본 90%면 충분해요.</li>
      <li>'JPG로 변환'을 누르고, 끝나면 한 장씩 저장하거나 ZIP으로 받아요.</li>
    </ol>
    <h2>서버 업로드 없음</h2>
    <p>많은 변환 사이트는 사진을 서버로 올려서 바꿔요. 이 도구는 변환 프로그램을 브라우저로 불러와 내 기기 안에서 처리해요. 가족사진이나 신분증 사진도 밖으로 나가지 않아요.</p>
  </Fragment>
</ToolLayout>
