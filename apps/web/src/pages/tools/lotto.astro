---
import ToolLayout from '../../layouts/ToolLayout.astro';
import Lotto from '../../components/tools/Lotto.vue';
import DirectionTabs from '../../components/DirectionTabs.astro';
import { LOTTO_TABS } from '../../data/lottoTabs.js';

const faq = [
  { q: '이 번호로 하면 당첨 확률이 높아지나요?', a: '아니요. 로또는 모든 번호 조합의 당첨 확률이 같아요. 이 도구는 번호를 고르기 어려울 때 공정하게 무작위로 뽑아 주는 용도예요.' },
  { q: '번호는 어떻게 뽑나요?', a: '1부터 45까지 중에서 서로 다른 6개를 브라우저의 보안 난수로 뽑고, 작은 번호부터 정렬해서 보여줘요.' },
  { q: '꼭 넣고 싶은 번호가 있어요.', a: '"꼭 넣을 번호"에 최대 5개까지 적으면 모든 게임에 그 번호가 들어가고, 나머지만 무작위로 뽑아요. "뺄 번호"에 적은 번호는 나오지 않아요.' },
  { q: '공 색깔은 무슨 뜻인가요?', a: '번호대를 알아보기 쉽게 1~10, 11~20, 21~30, 31~40, 41~45 구간마다 색을 다르게 칠했어요.' },
  { q: '뽑은 번호가 저장되나요?', a: '아니요. 번호는 브라우저 안에서만 뽑고 어디에도 저장하지 않아요. 필요하면 "번호 복사"로 옮겨 두세요.' },
];
---
<ToolLayout
  slug="lotto"
  description="로또 6/45 번호를 무작위로 1~10게임 뽑아요. 꼭 넣을 번호와 뺄 번호를 정할 수 있고, 보안 난수로 공정하게 뽑아요. 뽑은 번호는 한 번에 복사할 수 있어요."
  lead="게임 수를 고르고 '번호 뽑기'를 누르세요."
  faq={faq}
>
  <DirectionTabs items={LOTTO_TABS} />
  <Lotto client:load />

  <Fragment slot="guide">
    <h2>로또 6/45 번호 규칙</h2>
    <p>1부터 45까지의 번호 중 서로 다른 6개를 고르는 방식이에요. 이 도구도 같은 규칙으로 중복 없이 6개를 뽑고, 보기 좋게 작은 번호부터 정렬해요.</p>
    <h2>고정수와 제외수</h2>
    <p>생일이나 기념일 숫자처럼 꼭 넣고 싶은 번호는 '꼭 넣을 번호'에, 피하고 싶은 번호는 '뺄 번호'에 적으세요. 고정수는 모든 게임에 들어가고, 나머지 자리만 무작위로 채워요.</p>
    <h2>확률에 대해</h2>
    <p>어떤 방법으로 고르든 각 조합의 당첨 확률은 같아요. 자동으로 뽑은 번호도, 직접 고른 번호도 마찬가지예요. 재미로 즐기고, 무리한 구매는 피하세요.</p>
  </Fragment>
</ToolLayout>
