---
import ToolLayout from '../../layouts/ToolLayout.astro';
import DirectionTabs from '../../components/DirectionTabs.astro';
import IdPhoto from '../../components/tools/IdPhoto.vue';
import { PHOTO_TABS } from '../../data/photoTabs.js';

const faq = [
  { q: '운전면허증 사진 규격은 얼마인가요?', a: '가로 3.5cm, 세로 4.5cm예요. 여권·주민등록증 사진과 같은 크기라서 같은 사진을 함께 쓸 수 있어요. 300dpi 기준으로는 413×531픽셀이에요.' },
  { q: '어떤 사진이어야 하나요?', a: '신청일 기준 6개월 안에 찍은, 모자를 벗은 상반신 컬러사진이어야 해요. 배경 없이 찍어야 해서 보통 흰 배경으로 준비해요.' },
  { q: '면허 갱신할 때 예전 사진을 써도 되나요?', a: '6개월 안에 찍은 사진이어야 해요. 오래된 사진은 다시 찍어서 준비하세요.' },
  { q: '온라인으로 갱신할 때 올리는 사진 파일 조건은요?', a: '온라인 신청에서 올리는 파일의 용량·형식 조건은 안전운전 통합민원 누리집의 신청 화면 안내를 따르세요. 이 도구로 3.5×4.5cm에 맞춰 저장한 JPG를 그대로 올리면 돼요.' },
  { q: '사진이 서버로 올라가나요?', a: '아니요. 자르기와 저장은 모두 브라우저 안에서 해요. 얼굴 사진이 내 기기를 떠나지 않아요.' },
];
---
<ToolLayout
  slug="driver-license-photo"
  description="운전면허증 갱신·재발급용 사진을 3.5×4.5cm 규격으로 바로 잘라요. 300dpi JPG로 저장하고, 사진은 서버에 올라가지 않아 안심하고 쓸 수 있어요."
  lead="사진을 올리고 끌어서 위치만 맞추면 운전면허증 규격(3.5×4.5cm)으로 저장돼요."
  faq={faq}
>
  <DirectionTabs items={PHOTO_TABS} />
  <IdPhoto client:load preset="passport" />

  <Fragment slot="guide">
    <h2>운전면허증 사진 기준</h2>
    <ul>
      <li><b>크기</b>: 가로 3.5cm × 세로 4.5cm (300dpi 기준 413×531픽셀)</li>
      <li><b>촬영 시기</b>: 신청일 기준 6개월 안</li>
      <li><b>모습</b>: 모자를 벗은 상반신, 컬러사진</li>
      <li><b>배경</b>: 배경 없이 촬영 (보통 흰 배경)</li>
    </ul>
    <p>여권·주민등록증 사진과 크기가 같아서, 한 번 맞춰 둔 사진을 여러 신분증에 같이 쓸 수 있어요. 다만 신분증마다 얼굴 크기·배경 같은 세부 기준이 다를 수 있으니 발급 기관 안내를 함께 확인하세요.</p>
    <h2>집에서 사진 준비하는 순서</h2>
    <ol>
      <li>흰 벽 앞에서 정면을 보고 어깨까지 나오게 찍어요. 그림자가 지지 않게 앞쪽이 밝은 곳이 좋아요.</li>
      <li>위의 도구에 사진을 올리면 운전면허 규격(3.5×4.5cm)이 이미 골라져 있어요.</li>
      <li>미리보기를 끌어서 얼굴이 점선 타원 안에 들어오게 맞추고 JPG로 저장해요.</li>
      <li>온라인 신청에는 파일을 그대로 올리고, 방문 신청이라면 3.5×4.5cm로 인화해 가져가요.</li>
    </ol>
    <h2>갱신·재발급은 어디서 하나요?</h2>
    <p>운전면허시험장이나 경찰서에서 방문 신청하거나, 안전운전 통합민원 누리집에서 온라인으로 신청할 수 있어요. 준비물과 수수료, 신청 기간은 바뀔 수 있으니 신청 전에 공식 안내를 확인하세요.</p>
  </Fragment>
</ToolLayout>
