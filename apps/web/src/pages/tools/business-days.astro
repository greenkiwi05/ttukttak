---
import ToolLayout from '../../layouts/ToolLayout.astro';
import DirectionTabs from '../../components/DirectionTabs.astro';
import BusinessDays from '../../components/tools/BusinessDays.vue';

const TABS = [{ href: '/tools/holidays/', label: '공휴일 달력' }, { href: '/tools/business-days/', label: '영업일 계산기' }];
const faq = [
  { q: '영업일은 어떻게 세나요?', a: '토요일, 일요일과 공휴일(대체·임시공휴일 포함)을 뺀 평일만 세요. 회사 창립기념일처럼 따로 쉬는 날이 있으면 "추가로 쉬는 날"에 넣어서 함께 뺄 수 있어요.' },
  { q: '"3영업일 이내"는 언제까지인가요?', a: '보통 기준일 다음 영업일부터 세요. 예를 들어 금요일에 접수했다면 월·화·수가 1·2·3영업일이에요. 계산기의 "며칠 영업일 뒤 날짜"도 이 방식으로 셉니다. 계약서나 기관마다 세는 방식이 다를 수 있으니 중요한 기한은 안내문을 함께 확인하세요.' },
  { q: '시작일 포함은 언제 켜나요?', a: '두 날짜 사이 영업일을 셀 때, 시작일과 끝 날짜를 기간에 넣을지 고를 수 있어요. 근무일이나 처리 기간처럼 첫날도 일하는 날이면 포함, 다음 날부터 세는 기한이면 끄면 돼요.' },
  { q: '공휴일 정보는 언제까지 있나요?', a: '한국천문연구원 특일 정보에 공개된 해까지 반영돼요. 아직 공휴일이 발표되지 않은 해가 계산에 들어가면, 그 해는 주말만 빼고 계산했다고 알려드려요.' },
  { q: '입력한 날짜는 저장되나요?', a: '아니요. 계산은 브라우저 안에서만 하고, 입력한 날짜는 서버로 보내지 않아요.' },
];
---
<ToolLayout
  slug="business-days"
  description="두 날짜 사이 영업일 수와 며칠 영업일 뒤 날짜를 주말·공휴일·대체공휴일을 빼고 계산해요. 회사 휴무일도 추가로 넣어서 뺄 수 있어요."
  lead="주말과 공휴일을 뺀 영업일을 바로 계산해 드려요."
  faq={faq}
>
  <DirectionTabs items={TABS} />
  <BusinessDays client:load />

  <Fragment slot="guide">
    <h2>영업일 계산이 필요할 때</h2>
    <ul>
      <li><b>처리 기한</b>: "접수 후 5영업일 이내 처리"가 언제까지인지 확인해요.</li>
      <li><b>배송·환불</b>: "영업일 기준 3~7일"이 실제로 며칠인지 계산해요.</li>
      <li><b>근무일 수</b>: 두 날짜 사이 실제로 일하는 날이 며칠인지 세요.</li>
    </ul>
    <h2>공휴일은 자동으로 빼요</h2>
    <p>한국천문연구원 특일 정보의 공휴일을 그대로 써서, 설날·추석 연휴와 대체공휴일, 임시공휴일까지 빼고 계산해요. 공휴일이 언제인지는 <a href="/tools/holidays/">공휴일 달력</a>에서 볼 수 있어요.</p>
    <h2>단순히 며칠인지 궁금하다면</h2>
    <p>주말과 공휴일을 빼지 않고 날짜 사이 전체 일수만 알고 싶다면 <a href="/tools/days-between/">일수 계산기</a>를 쓰세요.</p>
  </Fragment>
</ToolLayout>
