---
import ToolLayout from '../../layouts/ToolLayout.astro';
import DirectionTabs from '../../components/DirectionTabs.astro';
import WordCount from '../../components/tools/WordCount.vue';
import { TEXT_COUNT_TABS } from '../../data/textTabs.js';

const faq = [
  { q: '단어 수는 어떤 기준으로 세나요?', a: '띄어쓰기로 나눈 덩어리 중 글자나 숫자가 들어 있는 것을 1단어로 세요. well-known, don\'t처럼 하이픈이나 아포스트로피로 이어진 말은 1단어이고, " - "나 "…"처럼 기호만 있는 덩어리는 세지 않아요. 워드 프로그램과 같은 방식이에요.' },
  { q: '워드나 구글 문서와 숫자가 다르게 나와요.', a: '대부분 같지만, 프로그램마다 기호·숫자·URL을 세는 방식이 조금씩 달라서 몇 단어 차이가 날 수 있어요. 제출 기준이 정해져 있다면 그 프로그램의 숫자를 따르세요.' },
  { q: '한국어 글도 단어 수를 셀 수 있나요?', a: '네. 한국어는 띄어쓰기 단위(어절)로 세요. "학교에 간다"는 2단어예요. 한국어 글은 보통 글자 수로 분량을 정하니, 글자 수는 위 탭의 글자수 세기를 쓰세요.' },
  { q: '문장 수는 어떻게 세나요?', a: '마침표·물음표·느낌표 뒤에 띄어쓰기나 줄바꿈이 오면 문장이 끝난 것으로 봐요. 3.5처럼 숫자 안의 점은 문장 끝으로 보지 않아요. Mr. 같은 약어 뒤에서는 문장이 하나 더 많게 나올 수 있어요.' },
  { q: '읽는 시간은 어떻게 계산하나요?', a: '영어 글을 기준으로 1분에 약 200단어를 읽는다고 보고 어림한 값이에요. 발표 시간을 대략 가늠할 때 참고하세요.' },
  { q: '입력한 글이 저장되거나 전송되나요?', a: '아니요. 단어 수는 브라우저 안에서만 세고, 글은 어디에도 저장하거나 보내지 않아요. 과제나 지원서 에세이도 안심하고 붙여 넣으세요.' },
];
---
<ToolLayout
  slug="word-count"
  description="영어 에세이·과제의 단어 수를 바로 세요. 문장 수, 자주 쓴 단어, 읽는 시간까지 보여 주고 목표 단어 수를 넘기면 알려 줘요. 글은 저장되지 않아요."
  lead="글을 붙여 넣으면 단어 수가 바로 나와요."
  faq={faq}
>
  <DirectionTabs items={TEXT_COUNT_TABS} />
  <WordCount client:load />

  <Fragment slot="guide">
    <h2>영어 에세이 단어 수 맞추기</h2>
    <p>유학 지원서, 영어 과제, 토플·아이엘츠 라이팅은 "250 words 이상", "500 words 이내"처럼 단어 수로 분량을 정해요. 목표 단어 수를 넣으면 남은 단어 수와 진행 막대가 보이고, 넘치면 빨간색으로 알려 줘요. 마지막에 '초과분 자르기'로 끝을 맞출 수도 있어요.</p>
    <h2>세는 기준</h2>
    <ul>
      <li><b>단어</b>: 띄어쓰기로 나눈 덩어리 중 글자·숫자가 있는 것. well-known, don't는 1단어</li>
      <li><b>서로 다른 단어</b>: 대소문자를 구분하지 않고 겹치지 않게 센 단어 수</li>
      <li><b>문장</b>: 마침표·물음표·느낌표나 줄바꿈으로 끝나는 덩어리</li>
      <li><b>평균 단어 길이</b>: 단어 하나에 들어간 글자 수의 평균</li>
    </ul>
    <h2>같은 단어 반복 줄이기</h2>
    <p>'자주 쓴 단어'에는 두 번 이상 나온 단어를 많이 쓴 순서로 보여 줘요. the, and 같은 기능어는 빼고 보여 주니, important나 very good처럼 같은 표현을 너무 자주 쓰지 않았는지 확인하고 다른 단어로 바꿔 보세요.</p>
    <h2>글자 수가 필요하다면</h2>
    <p>자기소개서처럼 글자 수로 분량을 정하는 글은 위의 '글자수 세기' 탭에서 공백 포함·제외 글자 수와 바이트를 확인하세요.</p>
  </Fragment>
</ToolLayout>
