---
import ToolLayout from '../../layouts/ToolLayout.astro';
import Wheel from '../../components/tools/Wheel.vue';

const faq = [
  { q: '돌림판 결과는 공정한가요?', a: '돌리는 순간 브라우저의 보안 난수로 결과를 먼저 정하고, 판이 그 칸에 멈추도록 돌려요. 어느 칸이든 나올 확률이 같고, 돌리는 힘이나 타이밍과는 상관없어요.' },
  { q: '항목은 몇 개까지 넣을 수 있나요?', a: '40개까지 넣을 수 있어요. 항목이 많으면 칸이 좁아져서 글씨가 줄어들고, 긴 이름은 앞부분만 보여요.' },
  { q: '같은 항목을 여러 번 넣으면 어떻게 되나요?', a: '넣은 만큼 칸이 생겨요. 예를 들어 "짜장"을 두 번 넣으면 짜장이 나올 확률이 두 배가 돼요. 확률을 다르게 하고 싶을 때 쓰면 돼요.' },
  { q: '뽑힌 항목을 빼고 계속 돌릴 수 있나요?', a: '"뽑힌 항목은 빼고 계속 돌리기"를 켜면 결과가 나온 항목이 목록에서 자동으로 빠져요. 순서를 정하거나 한 명씩 뽑을 때 편해요.' },
  { q: '입력한 항목은 저장되나요?', a: '다음에 다시 쓰기 편하게 이 기기의 브라우저에만 기억해요. 서버로는 아무것도 보내지 않아요.' },
];
---
<ToolLayout
  slug="wheel"
  description="항목을 넣고 돌리면 공정하게 하나를 골라 주는 온라인 돌림판이에요. 점심 메뉴 추천, 벌칙 정하기, 순서 뽑기까지. 결과는 카톡으로 바로 공유해요."
  lead="고민될 땐 돌려서 정해요. 항목을 넣고 가운데 버튼을 누르세요."
  faq={faq}
>
  <Wheel client:load />

  <Fragment slot="guide">
    <h2>이럴 때 써요</h2>
    <ul>
      <li><b>점심 메뉴 고르기</b>: "점심 메뉴" 버튼을 누르면 자주 먹는 메뉴가 바로 들어가요. 우리 회사 근처 식당 이름으로 바꿔 써도 돼요.</li>
      <li><b>벌칙·당번 정하기</b>: 모임이나 회식에서 벌칙이나 설거지 당번을 정해요.</li>
      <li><b>순서 정하기</b>: "뽑힌 항목은 빼고 계속 돌리기"를 켜고 계속 돌리면 순서가 정해져요.</li>
    </ul>
    <h2>확률 조절하기</h2>
    <p>모든 칸이 나올 확률은 같아요. 어떤 항목이 더 자주 나오게 하고 싶다면 그 항목을 여러 번 적으면 돼요. 칸이 늘어난 만큼 확률이 올라가요.</p>
    <h2>다른 뽑기 도구</h2>
    <p>여러 명 중 당첨자를 뽑거나 팀을 나눌 때는 <a href="/tools/random-pick/">제비뽑기</a>, 결과를 이름과 짝지을 때는 <a href="/tools/ladder/">사다리타기</a>가 편해요.</p>
  </Fragment>
</ToolLayout>
