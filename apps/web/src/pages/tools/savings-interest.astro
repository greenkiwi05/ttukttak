---
import ToolLayout from '../../layouts/ToolLayout.astro';
import Savings from '../../components/tools/Savings.vue';

const faq = [
  { q: '적금 금리 5%면 이자도 5%인가요?', a: '아니요. 적금은 매달 넣은 돈마다 맡긴 기간이 달라요. 첫 달 납입금은 12개월, 마지막 달 납입금은 1개월 이자만 받아요. 그래서 12개월 단리 적금의 실제 이자는 연 금리의 절반 정도예요.' },
  { q: '단리와 월복리는 얼마나 차이 나나요?', a: '월복리는 매달 붙은 이자에도 다시 이자가 붙어요. 기간이 짧으면 차이가 작고, 길수록 커져요. 같은 금리라면 월복리가 조금 더 많아요.' },
  { q: '이자 세금은 얼마인가요?', a: '일반과세는 이자소득세와 지방소득세를 합쳐 보통 15.4%를 떼요. 비과세나 세금우대 상품은 가입 조건이 따로 있으니 상품 안내를 확인하고 세율 칸에 직접 넣으세요.' },
  { q: '은행 앱에서 본 금액과 조금 달라요.', a: '은행은 세금을 세목별로 10원 단위에서 자르거나, 날짜별로 이자를 계산하기도 해서 몇십 원 정도 차이가 날 수 있어요.' },
  { q: '예금은 어떻게 계산하나요?', a: '처음에 한 번 넣은 돈에 기간 동안 이자가 붙어요. 단리는 원금 × 연 금리 × 개월 ÷ 12, 월복리는 원금 × ((1 + 연 금리 ÷ 12)^개월 − 1)이에요.' },
];
---
<ToolLayout
  slug="savings-interest"
  description="적금·예금 이자를 단리와 월복리로 계산하고, 입력한 세율로 세금을 빼서 실제 만기 수령액을 알려줘요. 적금 이자가 생각보다 적은 이유도 정리했어요."
  lead="금액·기간·금리·세율을 넣으면 세후 만기 수령액을 알려드려요."
  faq={faq}
>
  <Savings client:load />

  <Fragment slot="guide">
    <h2>적금 이자가 생각보다 적은 이유</h2>
    <p>"연 4% 적금에 매달 100만 원"이면 1년 이자가 48만 원일 것 같지만, 실제 세전 이자는 26만 원이에요. 첫 달에 넣은 돈만 12개월 이자를 받고, 마지막 달에 넣은 돈은 1개월 이자만 받기 때문이에요. 단리 적금 이자는 월 납입액 × 연 금리 ÷ 12 × n(n+1) ÷ 2로 계산해요.</p>
    <h2>예금과 적금</h2>
    <ul>
      <li><b>예금</b>: 목돈을 한 번에 맡기고 만기에 이자를 받아요.</li>
      <li><b>적금</b>: 매달 정해진 돈을 넣어요. 이 계산기는 매달 초에 같은 금액을 넣는 정액적립식으로 계산해요.</li>
    </ul>
    <h2>세율은 직접 확인하세요</h2>
    <p>이자에는 세금이 붙고, 상품에 따라 비과세나 세금우대가 적용되기도 해요. 세율과 가입 조건은 제도에 따라 바뀔 수 있어서 이 계산기는 세율을 직접 입력하게 했어요. 버튼은 자주 쓰는 값을 빠르게 넣는 기능이에요.</p>
  </Fragment>
</ToolLayout>
