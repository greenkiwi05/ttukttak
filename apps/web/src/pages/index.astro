---
import Base from '../layouts/Base.astro';
import { CATEGORIES, toolsIn } from '../data/tools.js';
import { SITE } from '../data/site.js';

const groups = Object.entries(CATEGORIES).map(([key, cat]) => ({ key, ...cat, tools: toolsIn(key) }));
---
<Base title={SITE.name} description="만 나이, D-day, 평수 변환부터 HEIC·PDF 변환까지. 설치·회원가입 없이 브라우저에서 바로 쓰는 무료 생활 도구 모음.">
  <section class="hero">
    <h1>필요한 계산, <span>뚝딱</span> 끝</h1>
    <p class="lead">설치·가입 없이 바로 쓰는 생활 도구. 파일은 서버로 올라가지 않아요.</p>
    <button type="button" class="home-search" data-open-search>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
      <span class="pc-only">어떤 도구가 필요하세요? (예: PDF 합치기, 나이, 용량)</span><span class="m-only">도구 검색 (예: PDF, 나이, 용량)</span>
      <kbd>/</kbd>
    </button>
  </section>

  {groups.map((g) => (
    <section class="home-group" id={g.key}>
      <div class="group-head">
        <h2><span aria-hidden="true">{g.emoji}</span> {g.label}</h2>
        <a class="more" href={`/category/${g.key}/`}>전체 보기 →</a>
      </div>
      <div class="tool-grid compact">
        {g.tools.map((t) => (
          <a class="tool-card" href={`/tools/${t.slug}/`}>
            <strong>{t.title}</strong>
            <small>{t.short}</small>
          </a>
        ))}
      </div>
    </section>
  ))}
</Base>
