---
// 모든 도구 페이지의 공통 틀:
// 제목 → 도구(slot) → 광고 → 설명(slot "guide") → FAQ → 다른 도구
// FAQ는 화면에도 보이고 FAQPage 구조화 데이터로도 들어간다.
import Base from './Base.astro';
import AdSlot from '../components/AdSlot.astro';
import { getTool, relatedTools, CATEGORIES } from '../data/tools.js';
import { SITE } from '../data/site.js';

interface Props {
  slug: string;
  description: string;   // meta description (120자 안팎)
  lead: string;          // 제목 아래 한 줄 안내
  faq: { q: string; a: string }[];
}
const { slug, description, lead, faq } = Astro.props;
const tool = getTool(slug);
if (!tool) throw new Error(`tools.js에 등록되지 않은 slug: ${slug}`);
const related = relatedTools(slug);
const url = new URL(`/tools/${slug}/`, Astro.site).href;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: tool.title,
    url,
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Any',
    inLanguage: 'ko',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'KRW' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: SITE.name, item: new URL('/', Astro.site).href },
      { '@type': 'ListItem', position: 2, name: CATEGORIES[tool.category].label, item: new URL(`/category/${tool.category}/`, Astro.site).href },
      { '@type': 'ListItem', position: 3, name: tool.title, item: url },
    ],
  },
];
---
<Base title={tool.title} description={description} jsonLd={jsonLd} active={tool.category} ogImage={`/og/${slug}.png`}>
  <nav class="crumb" aria-label="현재 위치">
    <a href="/">홈</a> › <a href={`/category/${tool.category}/`}>{CATEGORIES[tool.category].label}</a>
  </nav>
  <h1>{tool.title}</h1>
  <p class="lead">{lead}</p>

  <section class="card">
    <slot />
  </section>

  <AdSlot />

  <article class="prose">
    <slot name="guide" />
  </article>

  <section class="faq-box">
    <h2>자주 묻는 질문</h2>
    {faq.map((f) => (
      <details class="faq">
        <summary>{f.q}</summary>
        <p>{f.a}</p>
      </details>
    ))}
  </section>

  {related.length > 0 && (
    <section>
      <h2>다른 도구</h2>
      <div class="tool-grid">
        {related.map((t) => (
          <a class="tool-card" href={`/tools/${t.slug}/`}>
            <strong>{t.title}</strong>
            <small>{t.short}</small>
          </a>
        ))}
      </div>
    </section>
  )}
  <!--
    한글 입력 즉시 반영: Vue v-model은 한글 조합 중(compositionstart~end)에는 값을 반영하지 않아서
    "홍길동"을 칠 때 마지막 글자가 조합 중이면 "홍길"로만 계산된다(칸 밖을 눌러야 3글자).
    입력칸에서 Vue가 composing 표시를 켠 직후(이벤트가 document까지 올라왔을 때) 다시 꺼서 조합 중에도 반영되게 한다.
  -->
  <script is:inline>
    document.addEventListener('compositionstart', function (e) { if (e.target && 'composing' in e.target) e.target.composing = false; });
  </script>
</Base>
