// Cloudflare Workers 배포 설정.
// - 정적 사이트: 빌드 결과 apps/web/dist를 정적 자산으로 올린다.
// - 백엔드: /api/* 요청만 Worker(apps/api/src/index.js)가 먼저 받는다. 나머지는 바로 정적 자산.
// 비밀 값은 여기에 넣지 않는다 (대시보드 Variables and Secrets 또는 `wrangler secret put`).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ttukttak",
  "compatibility_date": "2026-11-01",
  "main": "./apps/api/src/index.js",
  "assets": {
    "directory": "./apps/web/dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  // 환율 저장소. id 없이 두면 첫 배포 때 자동으로 만들어진다.
  "kv_namespaces": [{ "binding": "RATES" }],
  // 과거 환율 DB (SQLite). id 없이 두면 첫 배포 때 자동으로 만들어진다. 테이블은 Worker가 직접 만든다 (CREATE TABLE IF NOT EXISTS).
  "d1_databases": [{ "binding": "DB", "database_name": "ttukttak-rates" }],
  // 정기 작업 시각 (UTC). 무엇을 언제 왜 부르는지는 apps/api/src/schedule.js 일정표에 모아 둠 (`npm run schedule`로 보기).
  // 여기와 일정표의 cron이 어긋나면 apps/api/tests/schedule.test.js가 실패한다.
  "triggers": { "crons": ["*/10 2-3 * * MON-FRI", "0 8 * * MON-FRI", "5 * * * *", "35 * * * *"] },
  "observability": { "enabled": true }
}
